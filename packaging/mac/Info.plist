<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Info.plist for Start-Blog.app — turns the CLI blog server into a double-click
     macOS app that runs with NO terminal window. The Dock icon represents the
     running server; quitting it (right-click Dock → 退出) stops the blog.
     CFBundleExecutable points at the "launch" script in Contents/MacOS/. -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Start-Blog</string>
  <key>CFBundleDisplayName</key>
  <string>dev@home 博客</string>
  <key>CFBundleIdentifier</key>
  <string>com.devhome.blog</string>
  <key>CFBundleExecutable</key>
  <string>launch</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>LSMinimumSystemVersion</key>
  <string>10.13</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
